msgid ""
"\n"
"              The Apprise API encountered an internal error while processing\n"
"              your request.\n"
"      "
msgstr ""
"\n"
"Ang Apprise API ay nakaranas ng panloob na error habang pinoproseso ang iyong kahilingan."

