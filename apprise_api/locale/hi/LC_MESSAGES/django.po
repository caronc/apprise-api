#: apprise_api/api/views.py:3190
msgid "The format field must be a string or null"
msgstr "फ़ॉर्मेट फ़ील्ड एक स्ट्रिंग या शून्य होना चाहिए"

#: apprise_api/api/views.py:3231
msgid "Bad FORM Payload provided"
msgstr "खराब FORM पेलोड प्रदान किया गया"

#: apprise_api/api/views.py:3251
msgid "The template field must be an object of name/value pairs"
msgstr "टेम्पलेट फ़ील्ड नाम/मान जोड़े वाले ऑब्जेक्ट होना चाहिए"

#: apprise_api/api/views.py:3281 apprise_api/api/views.py:3300
msgid "A specific tag other than 'all' is required for this configuration"
msgstr "इस कॉन्फ़िगरेशन के लिए 'all' के अलावा एक विशेष टैग आवश्यक है"

#: apprise_api/api/views.py:3293
msgid "Unsupported characters found in tag definition"
msgstr "टैग परिभाषा में असमर्थित वर्ण पाए गए"

#: apprise_api/api/views.py:3339
msgid "Bad Attachment"
msgstr "खराब संलग्नक"

#: apprise_api/api/views.py:3371
msgid "An invalid body input format was specified"
msgstr "एक अमान्य बॉडी इनपुट फ़ॉर्मेट निर्दिष्ट किया गया"

#: apprise_api/api/views.py:3408
msgid "The recursion limit has been reached"
msgstr "पुनरावृत्ति सीमा तक पहुँच गई"

#: apprise_api/api/views.py:3420
msgid "An invalid recursion value was specified"
msgstr "एक अमान्य पुनरावृत्ति मान निर्दिष्ट किया गया"

#: apprise_api/api/views.py:3440
msgid "An error occurred preparing the notification"
msgstr "सूचना"

#: apprise_api/api/views.py:3511 apprise_api/api/views.py:3714
msgid "Payload lacks minimum requirements"
msgstr "तैयार करते समय एक त्रुटि हुई। पेलोड में न्यूनतम आवश्यकताएँ नहीं हैं"

#: apprise_api/api/views.py:3675
msgid "This configuration does not permit stateless notifications"
msgstr "यह कॉन्फ़िगरेशन स्टेटलेस सूचनाओं की अनुमति नहीं देता"

#: apprise_api/api/views.py:3752
msgid "There was no valid URLs provided to notify"
msgstr "सूचित करने के लिए कोई मान्य URL प्रदान नहीं किया गया"

#: apprise_api/core/middleware/csrf.py:78
msgid "Cross-site request rejected"
msgstr "क्रॉस-साइट अनुरोध अस्वीकार कर दिया गया"

#: apprise_api/error/templates/401.html:17
msgid "Authentication Required"
msgstr "प्रमाणीकरण आवश्यक है"

#: apprise_api/error/templates/401.html:19
msgid "Enter valid credentials to access this resource."
msgstr "इस संसाधन तक पहुँचने के लिए मान्य साख दर्ज करें।"

#: apprise_api/error/templates/403.html:16 apprise_api/error/views.py:59
msgid "Permission Denied"
msgstr "अनुमति अस्वीकृत"

#: apprise_api/error/templates/403.html:18
msgid "Your account does not have permission to access this resource."
msgstr "आपके खाते को इस संसाधन तक पहुँचने की अनुमति नहीं है।"

#: apprise_api/error/templates/404.html:20
msgid "Page Not Found"
msgstr "पृष्ठ नहीं मिला"

#: apprise_api/error/templates/404.html:23
msgid ""
"\n"
"      The resource you requested could not be found on this Apprise API\n"
"      instance.\n"
"      "
msgstr ""
"\n"
"आपने जिस संसाधन का अनुरोध किया वह इस Apprise API उदाहरण पर पाया नहीं जा सका।"

#: apprise_api/error/templates/405.html:20 apprise_api/error/views.py:118
msgid "Method Not Allowed"
msgstr "तरीका अनुमति नहीं है"

#: apprise_api/error/templates/405.html:23
#, python-format
msgid ""
"\n"
"      This resource supports %(allowed_methods)s requests.\n"
"      "
msgstr ""
"\n"
"यह संसाधन %(allowed_methods)s अनुरोधों का समर्थन करता है।"

#: apprise_api/error/templates/413.html:16 apprise_api/error/views.py:135
msgid "Content Too Large"
msgstr "सामग्री बहुत बड़ी है"

#: apprise_api/error/templates/413.html:18
msgid "Reduce the request size or attachments, then try again."
msgstr "अनुरोध का आकार या संलग्नक कम करें, फिर पुनः प्रयास करें।"

#: apprise_api/error/templates/414.html:16 apprise_api/error/views.py:150
msgid "URI Too Long"
msgstr "URI बहुत लंबा"

#: apprise_api/error/templates/414.html:18
msgid "Shorten the request URL or move its data into the request body."
msgstr "अनुरोध को छोटा करें URL या उसके डेटा को अनुरोध बॉडी में ले जाएँ।"

#: apprise_api/error/templates/421.html:20
msgid "Misdirected Request"
msgstr "गलत दिशा में अनुरोध"

#: apprise_api/error/templates/421.html:23
msgid ""
"\n"
"      The resource you requested is not accessible due to the server configuration\n"
"      "
msgstr ""
"\n"
"जिस संसाधन का आपने अनुरोध किया वह सर्वर कॉन्फ़िगरेशन के कारण सुलभ नहीं है"

#: apprise_api/error/templates/429.html:17 apprise_api/error/views.py:197
msgid "Too Many Requests"
msgstr "बहुत अनुरोध"

#: apprise_api/error/templates/429.html:20
#, python-format
msgid "Too many login attempts were made. Wait %(retry_after)s seconds before trying again."
msgstr "बहुत सारे लॉगिन प्रयास किए गए। फिर से प्रयास करने से पहले %(retry_after)s सेकंड प्रतीक्षा करें।"

#: apprise_api/error/templates/50x.html:20
msgid "Service Temporarily Unavailable"
msgstr "सेवा अस्थायी रूप से अनुपलब्ध"

#: apprise_api/error/templates/50x.html:23
msgid ""
"\n"
"              The Apprise API encountered an internal error while processing\n"
"              your request.\n"
"      "
msgstr ""
"\n"
"आपके अनुरोध को संसाधित करते समय Apprise API ने आंतरिक त्रुटि का सामना किया।"

#: apprise_api/error/views.py:90 apprise_api/error/views.py:181
msgid "Page not found"
msgstr "पृष्ठ नहीं मिला"

#: apprise_api/error/views.py:233
msgid "System error"
msgstr "सिस्टम त्रुटि"
