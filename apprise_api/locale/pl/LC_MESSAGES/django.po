msgstr "URL, jeśli klucz był <em>%(key)s</em>"

#: apprise_api/api/templates/welcome.html:451
#, python-format
msgid ""
"There are no arguments required. If configuration id of <em>%(key)s</em> exists and has data associated with\n"
