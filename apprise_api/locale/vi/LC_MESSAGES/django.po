#: apprise_api/api/templates/welcome.html:520
#, python-format
msgid ""
"This is an alias of <code>%(BASE_URL)s/get/<em>%(key)s</em></code> defined above. It provides a means of remotely fetching it's\n"
"            the configuration associated with the configuration identified through the id of <em>%(key)s</em>."
msgstr "Đây là một bí danh của <code>%(BASE_URL)s/get/<em>%(key)s</em></code> được định nghĩa ở trên. Nó cung cấp một phương thức để lấy từ xa cấu hình của nó liên quan đến cấu hình được xác định thông qua id của <em>%(key)s</em>."

#: apprise_api/api/templates/welcome.html:534
#, python-format
msgid "Notifies the URLs associated with configuration identified by the id of <em>%(key)s</em>."
msgstr "Thông báo các URL liên kết với cấu hình được xác định bởi id của <em>%(key)s</em>."

#: apprise_api/api/templates/welcome.html:551
msgid ""
"The title to include in the notification. This is an optional\n"
