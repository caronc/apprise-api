msgstr "Không cần tham số nào. Nếu id cấu hình của <em>%(key)s</em> tồn tại và có dữ liệu liên quan, nó sẽ bị xóa."

#: apprise_api/api/templates/welcome.html:454
#, python-format
msgid "Remove previously loaded configuration associated with the id of <em>%(key)s</em>"
msgstr "Xóa cấu hình đã tải trước đó liên quan đến id của <em>%(key)s</em>"

#: apprise_api/api/templates/welcome.html:465
#, python-format
msgid "The request if the key was <em>%(key)s</em>"
msgstr "Yêu cầu nếu khóa là <em>%(key)s</em>"

#: apprise_api/api/templates/welcome.html:506
#, python-format
msgid ""
"This feature can be used by Apprise itself. It provides a means of remotely fetching it's\n"
"            the configuration associated with the configuration identified through the id of <em>%(key)s</em>."
msgstr "Tính năng này có thể được sử dụng bởi chính Apprise. Nó cung cấp một phương thức để lấy từ xa cấu hình của nó liên quan đến cấu hình được xác định thông qua id của <em>%(key)s</em>."

#: apprise_api/api/templates/welcome.html:510
#: apprise_api/api/templates/welcome.html:524
