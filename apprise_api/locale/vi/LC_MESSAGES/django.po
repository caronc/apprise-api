#: apprise_api/api/templates/welcome.html:12
msgid ""
"\n"
"      <a target=\"_blank\" href=\"https://github.com/caronc/apprise\" rel=\"nofollow noopener noreferrer\">Apprise</a> allows you to send a notification to almost\n"
"      all of the most popular notification services available to us today such as: <em>Telegram</em>, <em>Discord</em>,\n"
"      <em>Slack</em>, <em>Amazon SNS</em>, <em>Gotify</em>, etc.\n"
"      This API provides a simple gateway to directly access it via an HTTP interface."
msgstr ""
"\n"
"<a target=\"_blank\" href=\"https://github.com/caronc/apprise\" rel=\"nofollow noopener noreferrer\">Apprise</a> cho phép bạn gửi thông báo tới hầu hết các dịch vụ thông báo phổ biến nhất hiện nay như: <em>Telegram</em>, <em>Discord</em>, <em>Slack</em>, <em>Amazon SNS</em>, <em>Gotify</em>, v.v. API này cung cấp một cổng đơn giản để truy cập trực tiếp thông qua giao diện HTTP."

#: apprise_api/api/templates/welcome.html:20
msgid ""
"This project was designed to be incredibly light\n"
"        weight."
msgstr "Dự án này được thiết kế để cực kỳ nhẹ."

#: apprise_api/api/templates/welcome.html:24
msgid ""
"Configuration can be persistently stored for\n"
"        retrieval."
msgstr "Cấu hình có thể được lưu trữ liên tục để truy xuất."

#: apprise_api/api/templates/welcome.html:31
msgid "Stateless Endpoints"
msgstr "Các điểm cuối không trạng thái"

#: apprise_api/api/templates/welcome.html:35
msgid ""
"Those who wish to treat this API as nothing but a <a href=\"https://docs.microsoft.com/en-us/azure/architecture/patterns/sidecar\" target=\"_blank\" rel=\"nofollow noopener noreferrer\">sidecar</a> and/or\n"
"    microservice to their project only need to use the following URL."
msgstr "Những người muốn coi API này chỉ là một <a href=\"https://docs.microsoft.com/en-us/azure/architecture/patterns/sidecar\" target=\"_blank\" rel=\"nofollow noopener noreferrer\">sidecar</a> và/hoặc microservice cho dự án của họ chỉ cần sử dụng URL sau đây."

