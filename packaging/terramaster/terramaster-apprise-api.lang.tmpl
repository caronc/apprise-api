# ============================================================
# Multilingual file for the Apprise API TOS 7 Docker application.
# File name MUST be: apprise-terramaster-tos7-app.lang
# ============================================================

[en-us]
name = "Apprise"
auth = "Chris Caron"
descript = "A self-hosted REST API gateway for Apprise. Send notifications to 150+ services (Slack, Discord, Telegram, Email, SMS, and more) through one unified API, with per-key persistent configuration."
release_note = "{{RELEASE_NOTE}}"
important = "Requires DockerEngine, installed and enabled from the TOS App Center. The Docker image is pulled from Docker Hub only."

