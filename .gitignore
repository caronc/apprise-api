# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# vi swap files
.*.sw?

# Development leftovers
attach/
config/
plugin/

# Distribution / packaging / virtualenv
.Python
.bash_history
env/
.venv*/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
.local/
lib64
lib
var/
include/
bin/
parts/
sdist/
pyvenv.cfg
*.egg-info/
.installed.cfg
*.egg
pip-selfcheck.json

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Allow RPM SPEC files despite pyInstaller ignore
!packaging/redhat/*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage-reports/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
coverage.json
*,cover
.hypothesis/

# Translations
*.mo

# Browser-login key the server creates beside its configurations
.web_auth_secret*

# Django stuff:
*.log

# PyBuilder
target/

#Ipython Notebook
.ipynb_checkpoints

#PyCharm
.idea

# Apprise Gateway Variable/Test Configuration
apprise_gw/var/*

# TerraMaster TOS package build output
# controlled via build-package.py
packaging/terramaster/dist/
